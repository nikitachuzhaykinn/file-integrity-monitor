# Пример конфигурации для FIM
# Скопируйте этот файл в fim.yaml и отредактируйте под свои нужды
# Выберите профиль через переменную окружения FIM_PROFILE (по умолчанию default)

default:
  target_directory: ./test_folder
  baseline_file: baseline.json
  baseline_signature_file: baseline.json.sig
  chunk_size: 4096
  encoding: utf-8
  private_key_file: keys/private_key.pem
  public_key_file: keys/public_key.pem
  keyring_username: fim_user
  use_keyring: true
  rsa_key_size: 2048
  encrypted_private_key_file: keys/private_key.enc
  # Логирование
  log_file: logs/fim.log
  log_max_bytes: 5242880
  log_backup_count: 3
  log_level: INFO
  # JSON-логи
  log_json_enabled: true
  log_json_file: logs/fim.json
  log_json_max_bytes: 5242880
  log_json_backup_count: 3
  hash_algorithms:
    - sha256
    - sha512
    - blake2b
  ignore_patterns:
    - "*.tmp"
    - "__pycache__"
    - ".git"
    - "*.log"
    - "Thumbs.db"
  code_baseline_file: code_baseline.json
  code_baseline_signature_file: code_baseline.json.sig
  code_ignore_patterns:
    - "venv"
    - ".git"
    - "logs"
    - "keys"
    - "__pycache__"
    - "*.pyc"

production:
  target_directory: /var/www/html
  baseline_file: /etc/fim/baseline.json
  baseline_signature_file: /etc/fim/baseline.json.sig
  chunk_size: 8192
  encoding: utf-8
  private_key_file: /etc/fim/keys/private_key.pem
  public_key_file: /etc/fim/keys/public_key.pem
  keyring_username: fim_prod
  use_keyring: true
  rsa_key_size: 4096
  encrypted_private_key_file: /etc/fim/keys/private_key.enc
  # Логирование
  log_file: logs/fim.log
  log_max_bytes: 5242880
  log_backup_count: 3
  log_level: INFO
  # JSON-логи
  log_json_enabled: true
  log_json_file: logs/fim.json
  log_json_max_bytes: 5242880
  log_json_backup_count: 3
  hash_algorithms:
    - sha256
    - sha512
    - blake2b
  ignore_patterns:
    - "*.tmp"
    - "__pycache__"
    - ".git"
    - "*.log"
    - "Thumbs.db"
  code_baseline_file: /etc/fim/code_baseline.json
  code_baseline_signature_file: /etc/fim/code_baseline.json.sig
  code_ignore_patterns:
    - "venv"
    - ".git"
    - "logs"
    - "keys"
    - "__pycache__"
    - "*.pyc"