# Пример конфигурации для FIM
# Скопируйте этот файл в fim.yaml и отредактируйте под свои нужды
# Выберите профиль через переменную окружения FIM_PROFILE (по умолчанию default)

default:
  # Основные настройки
  target_directory: ./test_folder
  baseline_file: baseline.json
  baseline_signature_file: baseline.json.sig
  hash_algorithm: sha256
  chunk_size: 4096
  encoding: utf-8

  # Ключи
  private_key_file: keys/private_key.pem
  public_key_file: keys/public_key.pem
  keyring_username: fim_user
  use_keyring: true
  rsa_key_size: 2048
  encrypted_private_key_file: keys/private_key.enc

  # Логирование
  log_file: logs/fim.log
  log_max_bytes: 5242880   # 5 МБ
  log_backup_count: 3
  log_level: INFO

production:
  target_directory: /var/www/html
  baseline_file: /etc/fim/baseline.json
  baseline_signature_file: /etc/fim/baseline.json.sig
  hash_algorithm: sha512
  chunk_size: 8192
  encoding: utf-8

  private_key_file: /etc/fim/keys/private_key.pem
  public_key_file: /etc/fim/keys/public_key.pem
  keyring_username: fim_prod
  use_keyring: true
  rsa_key_size: 4096
  encrypted_private_key_file: /etc/fim/keys/private_key.enc

  log_file: /var/log/fim/fim.log
  log_max_bytes: 10485760  # 10 МБ
  log_backup_count: 5
  log_level: WARNING